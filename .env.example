# Alpaca paper credentials. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_CLI_PATH=alpaca
ALPACA_CLI_PROFILE=
ALPACA_CLI_VERSION=latest-tested-manually

# The competition agent fails closed unless an LLM is configured.
RANKER_MODE=llm
LLM_API_KEY=
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=

DATABASE_PATH=data/aegis_alpha.db
KILL_SWITCH=false
COMPETITION_ACCOUNT_ID=
COMPETITION_STARTING_EQUITY=100000
DRY_RUN=true

